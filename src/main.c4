
use vga::vga as vg
use serial::serial as serial
use pci::pci as pci
use std::io as io

pub fn main()->i32:
    vg::Color foregroundColor = vg::Color::Magenta
    vg::Color backgroundColor = vg::Color::Black
 
    vg::ColorCode colorCode
    colorCode.Set(foregroundColor,backgroundColor)

    vg::Vga vga
    vga.Set(753664 as char *,colorCode)
    vga.Print(" - VGA - is a go !!!!!!!!")
    vga.Print("----> Writing a Network Stack Now!!!!!!!!")

    serial::Serial serialDriver
    serialDriver.Init()
    serialDriver.Write("Serial Writing works ::: Sweet!!\n")
    serialDriver.Write("-> Kernel Messages !!\n")
    serialDriver.Write("-> More Logging !!\n")
    serialDriver.Write("-> More Logging 2.0 !!\n")


    pci::PCI pciDriver
    pciDriver.Init(pci::PCIPort::Address,pci::PCIPort::Data)
    pciDriver.Probe()

    serialDriver.Write("-> TODO => Implement Kernel Panic\n")
:
