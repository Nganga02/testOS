enum ArpConstant:
    ProtocolAddressLength = 4
    HardwareAddressLength = 6
:


struct ARPHeader:
    u16 HardwareType
    u16 ProtocolType 
    u8 HardwareLength
    u8 ProtocolLength
    u16 OperationType   
:

fn Htons(u16 data)->u16:
    return (data >> 8) | (data << 8)
:

fn Ntohs(u16 data)-u16:
    return Htons(data)
:

impl ARPHeader:
    fn SetHardwareType(u16 type):
        self->HardwareType = type
    :

    fn GetHardwareType()->u16:
        return self->HardwareType
    :

    fn SetProtocolType(u16 type):
        self->ProtocolType = type
    :

    fn GetProtocolType()->u16:
        return self->ProtocolType
    :

    fn SetHardwareLength(u8 length):
        self->HardwareType = type
    :

    fn GetHardwareLength()->u8:
        return self->HardwareType
    :

    fn SetProtocolLength(u8 length):
        self->ProtocolLength = type
    :

    fn GetProtocolLength()->u8:
        return self->ProtocolLength
    :

    fn SetOperationType(u16 type):
        self->OperationType = type
    :

    fn GetOperationType()->u16:
        return self->OperationType
    :
:   


struct EthernetARPHeader:
    struct ARPHeader ArpHeader
    u8 [ArpConstant::HardwareAddressLength]SenderHardwareAddress
    u8 [ArpConstant::ProtocolAddressLength]SenderProtocolAddress
    u8 [ArpConstant::HardwareAddressLength]TargetHardwareAddress
    u8 [ArpConstant::ProtocolAddressLength]TargetProtocolAddress
:


impl EthernetARPHeader:
    fn SetArpHeader(struct ARPHeader *arpHeader):
        u16 hostHardwareType = arpHeader.GetHardwareType()
        self->ArpHeader.SetHardwareType(Htons(hostHardwareType))

        u16 hostProtocolType = arpHeader.GetProtocolType()
        self->ArpHeader.SetProtocolType(Htons(hostProtocolType))

         u16 hostHardwareLength = arpHeader.GetHardwareLength()
        self->ArpHeader.SetHardwareLength(hostHardwareLength)

         u16 hostProtocolLength = arpHeader.GetProtocolLength()
        self->ArpHeader.SetProtocolLength(hostProtocolLength)

         u16 hostOperationType = arpHeader.GetOperationType()
        self->ArpHeader.SetOperationTYpe(Htons(hostOperationType))
    :

    fn GetArpHeader() -> struct ARPHeader:
        struct ARPHeader arpHeader

        u16 networkHardwareType = self->ArpHeader.GetHardwareType()
        arpHeader.SetHardwareType(Ntohs(networkHardwareType))

        u16 networkProtocolType =self->ArpHeader.GetProtocolType()
        arpHeader.SetProtocolType(Ntohs(networkProtocolType))

        u8 networkHardwareLength = self->ArpHeader.GetHardwareLength()
        arpHeader.SetHardwareLength(networkHardwareLength)

        u8 networkProtocolLength = self->ArpHeader.GetProtocolLength()
        arpHeader.SetProtocolLength(networkProtocolLength)

        u16 networkOperationType = self->ArpHeader.GetOperationType()
        arpHeader.SetOperationType(Ntohs(networkOperationType))

        return arpHeader
    :

    fn SetSenderHardwareAddress(str hardwareAddress):
        self->SenderHardwareAddress[0] = HardwareAddress[0]
        self->SenderHardwareAddress[1] = HardwareAddress[1]
        self->SenderHardwareAddress[2] = HardwareAddress[2]
        self->SenderHardwareAddress[3] = HardwareAddress[3]
        self->SenderHardwareAddress[4] = HardwareAddress[4]
        self->SenderHardwareAddress[5] = HardwareAddress[5]
    :

    fn GetSenderHardwareAddress()->str:
        str hardwareAddress
        HardwareAddress[0] = self->SenderHardwareAddress[0]
        HardwareAddress[1] = self->SenderHardwareAddress[1]
        HardwareAddress[2] = self->SenderHardwareAddress[2]
        HardwareAddress[3] = self->SenderHardwareAddress[3]
        HardwareAddress[4] = self->SenderHardwareAddress[4]
        HardwareAddress[5] = self->SenderHardwareAddress[5]
        return hardwareAddress
    :

    fn SetSenderProtocolAddress(str protocolAddress):
        self->SenderProtocolAddress[0] = ProtocolAddress[0]
        self->SenderProtocolAddress[1] = ProtocolAddress[1]
        self->SenderProtocolAddress[2] = ProtocolAddress[2]
        self->SenderProtocolAddress[3] = ProtocolAddress[3]
    :

    fn GetSenderProtocolAddress()->str:
        str protocolAddress
        HardwareAddress[0] = self->SenderHardwareAddress[0]
        HardwareAddress[1] = self->SenderHardwareAddress[1]
        HardwareAddress[2] = self->SenderHardwareAddress[2]
        HardwareAddress[3] = self->SenderHardwareAddress[3]
        return protocolAddress
    :

    fn SetTargetHardwareAddress(str hardwareAddress):
        self->TargetHardwareAddress[0] = HardwareAddress[0]
        self->TargetHardwareAddress[1] = HardwareAddress[1]
        self->TargetHardwareAddress[2] = HardwareAddress[2]
        self->TargetHardwareAddress[3] = HardwareAddress[3]
        self->TargetHardwareAddress[4] = HardwareAddress[4]
        self->TargetHardwareAddress[5] = HardwareAddress[5]
    :

    fn GetTargetHardwareAddress()->str:
        str hardwareAddress
        HardwareAddress[0] = self->TargetHardwareAddress[0]
        HardwareAddress[1] = self->TargetHardwareAddress[1]
        HardwareAddress[2] = self->TargetHardwareAddress[2]
        HardwareAddress[3] = self->TargetHardwareAddress[3]
        HardwareAddress[4] = self->TargetHardwareAddress[4]
        HardwareAddress[5] = self->TargetHardwareAddress[5]
        return hardwareAddress
    :

    fn SetTargetProtocolAddress(str hardwareAddress):
        self->TargetProtocolAddress[0] = HardwareAddress[0]
        self->TargetProtocolAddress[1] = HardwareAddress[1]
        self->TargetProtocolAddress[2] = HardwareAddress[2]
        self->TargetProtocolAddress[3] = HardwareAddress[3]
    :

    fn GetTargetProtocolAddress()->str:
        str protocolAddress
        HardwareAddress[0] = self->TargetProtocolAddress[0]
        HardwareAddress[1] = self->TargetProtocolAddress[1]
        HardwareAddress[2] = self->TargetProtocolAddress[2]
        HardwareAddress[3] = self->TargetProtocolAddress[3]
        return protocolAddress
    :
: