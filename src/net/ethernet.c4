struct EthernetHeader:
    u8 h_destination    [ETH_ALEN]
    u8 h_source         [ETH_ALEN]
    u16 h_proto
:

enum Lengths:
    Address = 6
    Type   = 2
    Fcs     = 4
    Header  = 14
:

fn htons(u16 type)->u16:
    return (type >> 8) | (type << 8)
:

impl EthernetHeader:
    fn SetDestinationAddress(char *dest_addr)->void:
        self->h_destination = dest_addr
    :

    fn GetDestination()->char*:
        return self->h_destination
    :

    fn SetSourceAddress(char *source_addr)->void:
        self->s_source = source_addr
    :

    fn GetSource()->char *:
        return self->h_source
    :

    fn set_type(int type)->void:
        self->proto = htons(type)
    :

    fn get_proto()->u16:
        return self->h_proto
    :
:


