fn Htons(u32 type):
    return htons(type);
:



cosnt enum
//BYTE ADDRESSABLE
const int ETH_ALEN = 6
const int ETH_TLEN = 2  
const int ETH_FCS  = 4
const int ETH_HLEN = 14


struct Ethhdr:
    unsigned char h_dest    [ETH_ALEN]
    unsigned char h_source  [ETH_ALEN]
    u16 h_proto
:



//we should convert host endianness to network endianness







impl Ethhdr:
    fn set_daddr(char *dest_addr)->void:
        self->h_dest = dest_addr
    :

    fn get_dest()->char*:
        return self->h_dest
    :

    fn set_saddr(char *source_addr)->void:
        self->s_source = source_addr
    :

    fn get_source()->char *:
        return self->h_source
    :

    fn set_type(int type)->void:
        self->proto = Htons(type)
    :

    fn get_proto()->u16:
        return self->h_proto
    :
:


