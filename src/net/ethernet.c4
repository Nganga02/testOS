struct EthernetHeader:
    u8 destination    [ETH_ALEN]
    u8 source         [ETH_ALEN]
    u16 protocol
:

enum Lengths:
    Address = 6
    Type   = 2
    Fcs     = 4
    Header  = 14
:

fn htons(u16 type)->u16:
    return (type >> 8) | (type << 8)
:

impl EthernetHeader:
    fn SetDestinationAddress(char *dest_addr)->void:
        self->destination = dest_addr
    :

    fn GetDestination()->char*:
        return self->destination
    :

    fn SetSourceAddress(char *source_addr)->void:
        self->source = source_addr
    :

    fn GetSource()->char *:
        return self->source
    :

    fn set_type(int type)->void:
        self->protocol = htons(type)
    :

    fn get_proto()->u16:
        return self->protocol
    :
:


