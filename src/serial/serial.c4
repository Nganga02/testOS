use io::port as ports



struct Serial:
    u16 port
    ports::Port8 data
    ports::Port8 interrupt
    ports::Port8 fifoControl
    ports::Port8 lineControl
    ports::Port8 modemControl
    ports::Port8 lineStatus
:




impl Serial:

    fn Init()->u16:
        ports::Port8 data
        ports::Port8 interrupt
        ports::Port8 fifoControl
        ports::Port8 lineControl
        ports::Port8 modemControl
        ports::Port8 lineStatus

        i32 ii = 0

        while ii < 4:
            u16 port = (1024 as u16 *)@offset(ii)@read()
            ii += 1

            if port == 0:
                continue
            :

            data.Init(port + 0)           // BASE_PORT + 0
            interrupt.Init(port + 1)      // BASE_PORT + 1
            fifoControl.Init(port + 2)    // BASE_PORT + 2
            lineControl.Init(port + 3)    // BASE_PORT + 3
            modemControl.Init(port + 4)   // BASE_PORT + 4
            lineStatus.Init(port + 5)     // BASE_PORT + 5


            interrupt.Write(0)
            lineControl.Write(128)
            data.Write(1)
            interrupt.Write(0)
            lineControl.Write(3)
            fifoControl.Write(0)
            modemControl.Write(11)


            self->data           = data
            self->interrupt      = interrupt
            self->fifoControl    = fifoControl
            self->lineControl    = lineControl
            self->modemControl   = modemControl
            self->lineStatus     = lineStatus

            break
       :
    :


    fn TransmitEmpty()->i32:
        return self->lineStatus.Read() & 32
    :

    fn WriteByte(char c)->void:
        while self->TransmitEmpty() == 0:
            // poll
        :

        self->data.Write(c)
    :

    fn Write(str message)->u32:
        u32 ii = 0

        while 1:
            char c = message[ii]

            if c == 0:
                break
            :

            self->WriteByte(c)

            ii += 1
        :

        return ii
    :

    fn WriteI32(i32 value)->void:
        if value == 0:
            self->WriteByte('0')
            return
        :

        if value < 0:
            self->WriteByte('-')
            value = -value
        :

        char [12]buffer
        u32 index = 0

        while value > 0:
            buffer[index] = '0' + (value % 10)
            value /= 10
            index += 1
        :

        while index > 0:
            index -= 1
            self->WriteByte(buffer[index])
        :
    :

    fn HexChar(u8 v)->char:
        if v < 10:
            return '0' + v
        :

        return 'a' + (v - 10)
    :


    fn WriteHex(u32 value)->void:
        char [11]buffer

        buffer[0] = '0'
        buffer[1] = 'x'

        u32 i = 0
        while i < 8:
            u8 nibble = (value >> (28 - i * 4)) & 15
            buffer[2 + i] = self->HexChar(nibble)
            i += 1
        :

        buffer[10] = 0

        self->Write(buffer)
    :

    fn WriteHexByte(u32 value)->void:
        char [9] buffer

        u32 index   = 0
        i32 started = 0
        u32 i       = 0

        while i < 8:
            u8 shift  = (7 - i) * 4
            u8 nibble = (value >> shift) & 15

            if nibble != 0 || started:
                started = 1
                buffer[index] = self->HexChar(nibble)
                index += 1
            :

            i += 1
        :

        if index == 0:
            buffer[0] = '0'
            index = 1
        :

        buffer[index] = 0

        char *ptr = buffer
        self->Write(ptr)
    :
:


