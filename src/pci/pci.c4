use io::port as ports
use serial::serial as serial
use net::rtl8139 as rtl8139

struct PCIDevice:
    u8 bus
    u8 device
    u8 function

    u16 vendorId
    u16 deviceId
    u16 command
    u16 status
    u8 revisionId
    u8 progIf
    u8 subClassId
    u8 classId
    u8 cacheLineSize
    u8 latencyTimer
    u8 headerType
    u8 bist
:


impl PCIDevice:
    fn HasMultipleFunctions()->i32:
        return self->headerType & (1 << 7)
    :

    fn IsAMDPCNet()->i32:
        return (self->vendorId == 4130) && (self->deviceId == 8192) 
    :

    fn IsRTL8139()->i32:
        return (self->vendorId == 4332) && (self->deviceId == 33081)
    :

    fn IsNetworkCard()->i32:
        return self->IsAMDPCNet() || self->IsRTL8139()
    :

    fn IsUSBController()->i32:
        return (self->classId == 12) && (self->subClassId == 3)
    :

:



struct PCIIOBar:
    u32 base
:

impl PCIIOBar:
    fn Init(u32 base)->i32:
        self->base = (base & ~3)

        return base & 1
    :
:

enum PCIPort:
    Address = 3320
    Data    = 3324
:

struct PCI:
    ports::Port32 address
    ports::Port32 data
:


impl PCI:
    fn Init(u16 addressPort,u16 dataPort)->void:
        self->address.Init(addressPort)
        self->data.Init(dataPort)
    :

    fn Read(u8 bus,u8 device,u8 function,u8 offset)->u16:
        u32 id = (1 << 31) | (bus << 16) | (device << 11) | (function << 8) | (offset & 252)
        self->address.Write(id)

        u32 data = self->data.Read()

        return (data >> ((offset & 2) * 8)) & 65535 
    :

    fn Read32(u8 bus,u8 device,u8 function,u8 offset)->u32:
        u32 id = (1 << 31) | (bus << 16) | (device << 11) | (function << 8) | (offset & 252)
        self->address.Write(id)

        u32 data = self->data.Read()

        return data
    :

    fn Write(u8 bus,u8 device,u8 function,u8 offset,u32 data)->void:
        u32 id = (1 << 31) | (bus << 16) | (device << 11) | (function << 8) | (offset & 252)
        self->address.Write(id)
        self->data.Write(data)
    :

    fn getPCIDevice(u8 bus,u8 device,u8 function)->PCIDevice:
        PCIDevice pciDevice

        pciDevice.bus           = bus
        pciDevice.device        = device
        pciDevice.function      = function

        
        pciDevice.vendorId      = (self->Read(bus,device,function,0)  >> 0) & 65535
        pciDevice.deviceId      = (self->Read(bus,device,function,2)  >> 0) & 65535
        pciDevice.command       = (self->Read(bus,device,function,4)  >> 0) & 65535
        pciDevice.status        = (self->Read(bus,device,function,6)  >> 0) & 65535
        pciDevice.revisionId    = (self->Read(bus,device,function,8)  >> 0) & 255
        pciDevice.progIf        = (self->Read(bus,device,function,8)  >> 8) & 255
        pciDevice.subClassId    = (self->Read(bus,device,function,10) >> 0) & 255
        pciDevice.classId       = (self->Read(bus,device,function,10) >> 8) & 255
        pciDevice.cacheLineSize = (self->Read(bus,device,function,12) >> 0) & 255
        pciDevice.latencyTimer  = (self->Read(bus,device,function,12) >> 8) & 255
        pciDevice.headerType    = (self->Read(bus,device,function,14) >> 0) & 255
        pciDevice.bist          = (self->Read(bus,device,function,14) >> 8) & 255

        return pciDevice
    :

    fn SetBusMastering(u8 bus,u8 device,u8 function)->void:
        u32 command = self->Read32(bus,device,function,4)
        command     = command | 4

        self->Write(bus,device,function,4,command)
    :

    fn getIOBar(u8 bus,u8 device,u8 function)->u32:

        serial::Serial serialDriver
        serialDriver.Init()
        u32 ii = 0

        while ii < 6:
            u32 offset = 16 + (ii * 4)
            u32 bar    = 0

            bar = self->Read32(bus,device,function,offset)

            PCIIOBar ioBar
            if ioBar.Init(bar):
                serialDriver.Write("Found I/O BAR  -> [")
                serialDriver.WriteHex(ioBar.base)
                serialDriver.Write("]\n")
                return ioBar.base
            :

            ii += 1
        :


        return 0
    :


    fn Probe()->void:
        serial::Serial serialDriver
        serialDriver.Init()

        u64 bus = 0
        
        while bus < 256:
            u64 device = 0

            while device < 32:
                pci::PCIDevice pciDevice = self->getPCIDevice(bus,device,0)
                u64 functions            = 1

                if pciDevice.HasMultipleFunctions() == 1:
                    functions = 8
                :

                u64 function = 0
        
                while function < functions:
                    pciDevice = self->getPCIDevice(bus,device,function)

                    if pciDevice.vendorId == 65535:
                        function += 1
                        continue
                    :


                    if pciDevice.IsUSBController() == 1:
                        serialDriver.Write("Found an USB Controller\n")
                    :

                    if pciDevice.IsAMDPCNet() == 1:
                        serialDriver.Write("Found a Network Card :: AMD PCNet\n")
                    :


                    if pciDevice.IsRTL8139() == 1:
                        serialDriver.Write("Found a Network Card :: RTL8139\n")
                        self->SetBusMastering(bus,device,function)
                        u16 base = self->getIOBar(bus,device,function) as u16


                        rtl8139::RTL8139 rtl8139Driver
                        rtl8139Driver.Init(base)
                        rtl8139Driver.PrintMacAddress()

                        serialDriver.Write("Reading the Mac Address Complete\n")
                    :

                    function += 1
                :

                device += 1
            :

            bus += 1
        :

        serialDriver.Write("====== probing Complete ==================\n\n")
    :
:






