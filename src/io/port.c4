use io::io as io

struct Port8:
    u16 port
:

impl Port8:
    fn Init(u16 port)->void:
        self->port = port
    :

    fn Read()->u8:
        return io::DeviceRead8(self->port)
    :

    fn Write(u8 data)->void:
        return io::DeviceWrite8(self->port,data)
    :
:



